# URL du an Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=

# Service Role Key cua Supabase (Project Settings -> API -> service_role secret)
# KHONG chia se khoa nay cong khai, khong dua vao code, khong commit len GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Mat khau de dang nhap trang quan tri /admin.html
ADMIN_PASSWORD=

# Chuoi bi mat ngau nhien, dung de ky phien dang nhap quan tri.
# Co the tao bang lenh: openssl rand -hex 32
ADMIN_SESSION_SECRET=
